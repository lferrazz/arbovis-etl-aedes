# Copie este arquivo para .env e preencha com seus dados reais.
# O arquivo .env NÃO é versionado (está no .gitignore).

# ID do projeto no Google Cloud
GCP_PROJECT_ID=arbovis-tcc

# Caminho para a chave JSON da service account (não versionar!)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-key.json

# Região dos datasets do BigQuery
BQ_LOCATION=southamerica-east1

# Chave de acesso à API (gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEY=troque_por_uma_chave_secreta
